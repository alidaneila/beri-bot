DISCORD_TOKEN=
CLIENT_ID=

# ngaktifin bot di server baru, dan otomatis dianggap admin item catalog juga.
OWNER_USER_ID=

OWNER_AVATAR_URL=
# LEGACY / MODE DEV — dulu dipakai buat single-server.
# Sekarang pengaturan per-server (channel salary, thread public/private, unsold board,
# auto-nick) diatur LEWAT COMMAND /setting server di masing-masing server, BUKAN di sini.
# ============================================================

# (Opsional) Kalau diisi, `npm run deploy-commands` daftar command instan ke 1 guild ini
aja (buat testing lokal). Kalau dikosongin, command didaftar GLOBAL (mode production,
# bisa dipakai di server manapun yang di-approve, tapi propagasi bisa sampai 1 jam).
GUILD_ID=

# (Opsional) Fallback channel salary kalau ada server yang lupa /setting server.
SALARY_CHANNEL_ID=

# (Opsional) Selain OWNER_USER_ID, user ID tambahan yang boleh /setting item.
ITEM_ADMIN_USER_ID=

# Lokasi file database SQLite 
DB_PATH=./data/bot.sqlite